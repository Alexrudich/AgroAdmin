@using AgroAdmin.Shared.Dto.Bookings.Requests
@using AgroAdmin.Shared.Dto.Bookings.Responses
@inject HttpClient Http
@inject NavigationManager Nav
@inject IJSRuntime Js

<PageTitle>Бронирования</PageTitle>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Учёт заездов</h1>
        <button class="btn btn-primary" @onclick='() => Nav.NavigateTo("/bookings/create")'>
            Новая бронь
        </button>
    </div>

    <BookingFilters Filter="filter"
                    ShowAdvancedFilters="_showAdvancedFilters"
                    ShowAdvancedFiltersChanged="((v) => _showAdvancedFilters = v)"
                    OnApply="ApplyFilters" />

    @if (_result == null)
    {
        <div class="d-flex justify-content-center p-5">
            <div class="spinner-border text-primary" role="status"></div>
        </div>
    }
    else if (!_result.Items.Any())
    {
        <div class="alert alert-info">Пока нет ни одного бронирования.</div>
    }
    else
    {
        <BookingTable Bookings="_result.Items"
                      Filter="filter"
                      OnSort="SortBy"
                      OnEdit="NavigateToEdit"
                      OnDelete="HandleDelete" />

        <BookingPagination Page="_result.Page"
                           PageSize="filter.PageSize"
                           TotalCount="_result.TotalCount"
                           TotalPages="_result.TotalPages"
                           OnPageSizeChange="OnPageSizeChange"
                           OnPrevious="PreviousPage"
                           OnNext="NextPage" />
    }
</div>

@code {
    private PagedResultDto<BookingDto>? _result;
    private readonly BookingFilterDto filter = new();
    private bool _showAdvancedFilters = false;

    protected override async Task OnInitializedAsync() => await LoadData();

    private async Task LoadData()
    {
        try
        {
            var query = BuildQueryString();
            _result = await Http.GetFromJsonAsync<PagedResultDto<BookingDto>>($"api/bookings{query}");
        }
        catch
        {
            _result = new PagedResultDto<BookingDto> { Items = new() };
        }
    }

    private string BuildQueryString()
    {
        var parameters = new List<string>();
        if (filter.Page > 1) parameters.Add($"page={filter.Page}");
        if (filter.PageSize != 20) parameters.Add($"pageSize={filter.PageSize}");
        if (!string.IsNullOrEmpty(filter.SortBy)) parameters.Add($"sortBy={filter.SortBy}");
        if (!filter.SortDesc) parameters.Add($"sortDesc=false");
        if (!string.IsNullOrEmpty(filter.SearchTerm)) parameters.Add($"searchTerm={Uri.EscapeDataString(filter.SearchTerm)}");
        if (filter.ReservedUnit.HasValue) parameters.Add($"reservedUnit={(int)filter.ReservedUnit}");
        if (filter.IsFirstTimeGuest.HasValue) parameters.Add($"isFirstTimeGuest={filter.IsFirstTimeGuest.Value}");
        if (filter.DateFrom.HasValue) parameters.Add($"dateFrom={filter.DateFrom:yyyy-MM-dd}");
        if (filter.DateTo.HasValue) parameters.Add($"dateTo={filter.DateTo:yyyy-MM-dd}");
        if (filter.NeedsSauna == true) parameters.Add($"needsSauna=true");
        if (filter.NeedsBanquetHall == true) parameters.Add($"needsBanquetHall=true");
        if (filter.HasDog == true) parameters.Add($"hasDog=true");
        return parameters.Any() ? "?" + string.Join("&", parameters) : "";
    }

    private async Task ApplyFilters()
    {
        filter.Page = 1;
        await LoadData();
    }

    private async Task SortBy(string field)
    {
        if (filter.SortBy == field) filter.SortDesc = !filter.SortDesc;
        else { filter.SortBy = field; filter.SortDesc = true; }
        await ApplyFilters();
    }

    private void NavigateToEdit(int id) => Nav.NavigateTo($"/bookings/edit/{id}");

    private async Task PreviousPage()
    {
        if (_result?.Page > 1) { filter.Page = _result.Page - 1; await LoadData(); }
    }

    private async Task NextPage()
    {
        if (_result != null && filter.Page < _result.TotalPages) { filter.Page = _result.Page + 1; await LoadData(); }
    }

    private async Task OnPageSizeChange(int newSize)
    {
        filter.PageSize = newSize;
        filter.Page = 1;
        await LoadData();
    }

    private async Task HandleDelete((int Id, string Name) data)
    {
        var (id, name) = data;
        bool confirmed = await Js.InvokeAsync<bool>("confirm", $"Вы уверены, что хотите удалить бронь гостя {name}?");
        if (confirmed)
        {
            var response = await Http.DeleteAsync($"api/bookings/{id}");
            if (response.IsSuccessStatusCode) await LoadData();
            else await Js.InvokeVoidAsync("alert", "Ошибка при удалении.");
        }
    }
}