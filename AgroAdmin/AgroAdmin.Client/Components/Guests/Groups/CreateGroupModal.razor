@using AgroAdmin.Shared.Dto.Guests
@inject HttpClient Http
@inject IJSRuntime JS

<div class="modal fade @(Show ? "show d-block" : "")" style="@(Show ? "background-color: rgba(0,0,0,0.5);" : "")" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title">➕ Новая группа гостей</h5>
                <button type="button" class="btn-close btn-close-white" @onclick="Close"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label">Название группы</label>
                    <input type="text" class="form-control" @bind="_model.Name" placeholder="Например: Семья Петровых" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Описание (необязательно)</label>
                    <textarea class="form-control" @bind="_model.Description" rows="2" placeholder="Комментарий"></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" @onclick="Close">Отмена</button>
                <button class="btn btn-primary" @onclick="Save" disabled="@string.IsNullOrWhiteSpace(_model.Name)">
                    ✅ Создать и добавить
                </button>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter] public bool Show { get; set; }
    [Parameter] public int GuestId { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnGroupCreated { get; set; }

    private CreateGroupRequestDto _model = new();

    private async Task Save()
    {
        var response = await Http.PostAsJsonAsync("api/guests/groups", _model);
        if (response.IsSuccessStatusCode)
        {
            var groupId = await response.Content.ReadFromJsonAsync<int>();
            await Http.PostAsJsonAsync($"api/guests/{GuestId}/groups", new AddToGroupRequestDto { GroupId = groupId });
            await OnGroupCreated.InvokeAsync();
            await Close();
        }
    }

    private async Task Close()
    {
        _model = new CreateGroupRequestDto();
        Show = false;
        await OnClose.InvokeAsync();
    }
}