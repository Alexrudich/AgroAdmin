@using AgroAdmin.Shared.Enums
@using AgroAdmin.Shared.Extensions

<div class="row mb-3">
    <div class="col-md-4">
        <label class="form-label fw-bold">📅 Заезд</label>
        <InputDate @bind-Value="Service.Booking.ArrivalDate" @onchange="OnDateChanged" class="form-control" />
    </div>
    <div class="col-md-4">
        <label class="form-label fw-bold">📅 Выезд</label>
        <InputDate @bind-Value="Service.Booking.DepartureDate" @onchange="OnDateChanged" class="form-control" />
    </div>
    <div class="col-md-4">
        <label class="form-label fw-bold">🏠 Объект</label>
        <InputSelect @bind-Value="Service.Booking.ReservedUnit" @onchange="OnUnitChanged" class="form-select">
            @foreach (var unit in Enum.GetValues<ReservedUnits>())
            {
                <option value="@unit">@unit.ToFriendlyString()</option>
            }
        </InputSelect>
    </div>
</div>

<div class="row mb-3 g-2">
    <div class="col-4">
        <div class="option-card @(Service.Booking.NeedsSauna ? "active" : "")">
            <div class="form-check form-switch d-flex justify-content-center">
                <input type="checkbox"
                       class="form-check-input"
                       id="sauna"
                       checked="@Service.Booking.NeedsSauna"
                       @onchange="@((ChangeEventArgs e) => OnOptionChanged(e, "sauna"))" />
                <label class="form-check-label ms-1" for="sauna">🌡️</label>
            </div>
            <div class="option-label">Баня</div>
        </div>
    </div>
    <div class="col-4">
        <div class="option-card @(Service.Booking.NeedsBanquetHall ? "active" : "")">
            <div class="form-check form-switch d-flex justify-content-center">
                <input type="checkbox"
                       class="form-check-input"
                       id="hall"
                       checked="@Service.Booking.NeedsBanquetHall"
                       @onchange="@((ChangeEventArgs e) => OnOptionChanged(e, "hall"))" />
                <label class="form-check-label ms-1" for="hall">🥂</label>
            </div>
            <div class="option-label">Зал</div>
        </div>
    </div>
    <div class="col-4">
        <div class="option-card @(Service.Booking.HasDog ? "active" : "")">
            <div class="form-check form-switch d-flex justify-content-center">
                <input type="checkbox"
                       class="form-check-input"
                       id="dog"
                       checked="@Service.Booking.HasDog"
                       @onchange="@((ChangeEventArgs e) => OnOptionChanged(e, "dog"))" />
                <label class="form-check-label ms-1" for="dog">🐕</label>
            </div>
            <div class="option-label">Собака</div>
        </div>
    </div>
</div>

<div class="row mb-3">
    <div class="col-md-4">
        <label class="form-label fw-bold">⏰ Время заезда</label>
        <InputTime @bind-Value="Service.Booking.CheckInTime" class="form-control" />
    </div>
    <div class="col-md-4">
        <label class="form-label fw-bold">💰 Стоимость проживания</label>
        <div class="input-group">
            <InputNumber @bind-Value="Service.Booking.AccommodationCost"
                         class="form-control"
                         step="10"
                         min="0"
                         format="N0" />
            <span class="input-group-text">BYN</span>
        </div>
        @if (Service.CurrentPricing != null && Service.CurrentPricing.TotalPrice > 0)
        {
            <div class="form-text text-success">
                <i class="bi bi-calculator"></i>
                <strong>Рекомендуемая цена:</strong> @Service.CurrentPricing.SuggestionText
            </div>
        }
        else
        {
            <div class="form-text text-muted">Оставьте пустым, если не указана</div>
        }
    </div>
</div>

@code {
    [Parameter] public BookingFormService Service { get; set; } = null!;
    [Parameter] public EventCallback OnDateChanged { get; set; }
    [Parameter] public EventCallback OnUnitChanged { get; set; }
    [Parameter] public EventCallback OnOptionsChanged { get; set; }

    private async Task OnOptionChanged(ChangeEventArgs e, string option)
    {
        bool isChecked = (bool)e.Value!;

        switch (option)
        {
            case "sauna":
                Service.Booking.NeedsSauna = isChecked;
                break;
            case "hall":
                Service.Booking.NeedsBanquetHall = isChecked;
                break;
            case "dog":
                Service.Booking.HasDog = isChecked;
                break;
        }

        await Service.OnOptionsChanged();
    }
}