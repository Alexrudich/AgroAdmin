@using AgroAdmin.Shared.Enums
@using AgroAdmin.Shared.Extensions

<div class="row mb-3">
    <div class="col-md-4">
        <label class="form-label fw-bold">📅 Заезд</label>
        <input type="date"
               class="form-control"
               value="@Service.Booking.ArrivalDate.ToString("yyyy-MM-dd")"
               @onchange="@((ChangeEventArgs e) => OnDateChanged(e, "arrival"))" />
    </div>
    <div class="col-md-4">
        <label class="form-label fw-bold">📅 Выезд</label>
        <input type="date"
               class="form-control"
               value="@Service.Booking.DepartureDate.ToString("yyyy-MM-dd")"
               @onchange="@((ChangeEventArgs e) => OnDateChanged(e, "departure"))" />
    </div>
    <div class="col-md-4">
        <label class="form-label fw-bold">🏠 Объект</label>
        <select class="form-select" @onchange="@((ChangeEventArgs e) => OnUnitChanged(e))">
            @foreach (var unit in Enum.GetValues<ReservedUnits>())
            {
                <option value="@((int)unit)" selected="@(Service.Booking.ReservedUnit == unit)">
                    @unit.ToFriendlyString()
                </option>
            }
        </select>
    </div>
</div>

@code {
    [Parameter] public BookingFormService Service { get; set; } = default!;

    private async Task OnDateChanged(ChangeEventArgs e, string type)
    {
        if (DateTime.TryParse(e.Value?.ToString(), out var newDate))
        {
            if (type == "arrival")
            {
                Service.Booking.ArrivalDate = newDate;
            }
            else
            {
                Service.Booking.DepartureDate = newDate;
            }
        }

        await Service.OnDateOrUnitChanged();
    }

    private async Task OnUnitChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var unitValue))
        {
            Service.Booking.ReservedUnit = (ReservedUnits)unitValue;
        }

        await Service.OnDateOrUnitChanged();
    }
}