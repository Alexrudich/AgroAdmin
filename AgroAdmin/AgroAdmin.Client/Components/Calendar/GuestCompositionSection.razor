<div class="row g-2 mb-3">
    <div class="col-4">
        <label class="form-label small mb-1">👨 Взрослые</label>
        <input type="number"
               @bind="Service.Booking.AdultsCount"
               @bind:event="oninput"
               @onchange="OnGuestCountChanged"
               class="form-control form-control-sm" />
    </div>
    <div class="col-4">
        <label class="form-label small mb-1">👦 Дети</label>
        <input type="number"
               @bind="Service.Booking.ChildrenCount"
               @bind:event="oninput"
               @onchange="OnGuestCountChanged"
               class="form-control form-control-sm" />
    </div>
    <div class="col-4">
        <label class="form-label small mb-1">👶 Младенцы</label>
        <input type="number"
               @bind="Service.Booking.InfantsCount"
               @bind:event="oninput"
               @onchange="OnGuestCountChanged"
               class="form-control form-control-sm" />
    </div>
    <div class="col-12 text-end mt-1">
        <small class="text-primary fw-bold">Итого: @Service.Booking.TotalGuestsCount чел.</small>
    </div>
</div>

@code {
    [Parameter] public BookingFormService Service { get; set; } = default!;

    private void OnGuestCountChanged()
    {
        Service.UpdateTotal();
        StateHasChanged();
    }
}