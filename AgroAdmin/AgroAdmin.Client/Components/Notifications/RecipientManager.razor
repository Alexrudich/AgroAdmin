@using AgroAdmin.Shared.Dto.Notifications
@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager Nav

<div class="card border-info shadow-sm">
    <div class="card-header bg-info text-white">
        <h5 class="mb-0">Управление получателями</h5>
    </div>
    <div class="card-body">
        <div class="row g-3 mb-3">
            <div class="col-md-4">
                <input @bind="_newName" class="form-control" placeholder="Имя получателя" />
            </div>
            <div class="col-md-3">
                <input @bind="_newChatId" class="form-control" placeholder="Chat ID" />
            </div>
            <div class="col-md-2">
                <select @bind="_newRole" class="form-select">
                    <option value="viewer">Просмотр</option>
                    <option value="manager">Управление</option>
                    <option value="admin">Админ</option>
                </select>
            </div>
            <div class="col-md-1">
                <div class="form-check mt-2">
                    <input @bind="_newIsDefault" class="form-check-input" type="checkbox" id="defaultCheck" />
                    <label class="form-check-label" for="defaultCheck">По умолч.</label>
                </div>
            </div>
            <div class="col-md-1">
                <div class="form-check mt-2">
                    <input @bind="_newIsActive" class="form-check-input" type="checkbox" id="activeCheck" />
                    <label class="form-check-label" for="activeCheck">Активен</label>
                </div>
            </div>
            <div class="col-md-1">
                <button class="btn btn-success w-100" @onclick="AddRecipient">➕</button>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table table-sm table-hover">
                <thead>
                    <tr>
                        <th>Имя</th>
                        <th>Chat ID</th>
                        <th>Роль</th>
                        <th>Активен</th>
                        <th>По умолч.</th>
                        <th>Команд/день</th>
                        <th>Последняя активность</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var r in _recipients)
                {
                    <tr class="@(!r.IsActive ? "table-secondary" : "")">
                        <td>
                            <input @bind="r.Name" 
                                   @bind:event="oninput" 
                                   @onblur="() => UpdateRecipient(r)" 
                                   class="form-control form-control-sm" />
                        </td>
                        <td>
                            <input @bind="r.ChatId" 
                                   @bind:event="oninput" 
                                   @onblur="() => UpdateRecipient(r)" 
                                   class="form-control form-control-sm" />
                        </td>
                        <td>
                            <select value="@r.Role" 
                                    @onchange="(args) => OnRoleChanged(r, args)" 
                                    class="form-select form-select-sm">
                                <option value="viewer">Просмотр</option>
                                <option value="manager">Управление</option>
                                <option value="admin">Админ</option>
                            </select>
                        </td>
                        <td class="text-center">
                            <input type="checkbox" 
                                   checked="@r.IsActive"
                                   @onchange="(args) => ToggleActive(r, args.Value as bool?)" />
                        </td>
                        <td class="text-center">
                            <input type="checkbox"
                                   checked="@r.IsDefault"
                                   @onchange="(args) => ToggleDefault(r, args.Value as bool?)" />
                        </td>
                        <td class="text-center">
                            <span class="badge @(r.CommandCountToday > 25 ? "bg-warning" : "bg-secondary")">
                                @r.CommandCountToday/30
                            </span>
                        </td>
                        <td>
                            @(r.LastActiveAt?.ToString("dd.MM HH:mm") ?? "никогда")
                        </td>
                        <td class="text-end">
                            <button class="btn btn-outline-danger btn-sm" @onclick="() => DeleteRecipient(r.Id)">🗑️</button>
                        </td>
                    </tr>
                }                </tbody>
            </table>
        </div>
        
        <small class="text-muted">
            💡 Роли: <strong>Просмотр</strong> - только чтение, <strong>Управление</strong> - может создавать бэкапы, 
            <strong>Админ</strong> - полный доступ
        </small>
    </div>
</div>

@code {
    [Parameter] public EventCallback OnChanged { get; set; }

    private HttpClient Http => HttpClientFactory.CreateClient("AgroAdmin");
    private List<TelegramRecipientDto> _recipients = [];
    private string _newName = "";
    private string _newChatId = "";
    private string _newRole = "viewer";
    private bool _newIsDefault = false;
    private bool _newIsActive = true;

    protected override async Task OnInitializedAsync() => await Load();

    private async Task Load()
    {
        _recipients = await Http.GetFromJsonAsync<List<TelegramRecipientDto>>("api/notifications/recipients") ?? [];
    }

    private async Task AddRecipient()
    {
        if (string.IsNullOrWhiteSpace(_newName) || string.IsNullOrWhiteSpace(_newChatId))
            return;

        await Http.PostAsJsonAsync("api/notifications/recipients",
            new TelegramRecipientDto
            {
                Name = _newName,
                ChatId = _newChatId,
                IsDefault = _newIsDefault,
                IsActive = _newIsActive,
                Role = _newRole
            });

        _newName = "";
        _newChatId = "";
        _newIsDefault = false;
        _newIsActive = true;
        _newRole = "Viewer";
        await Load();
        await OnChanged.InvokeAsync();
    }

    private async Task UpdateRecipient(TelegramRecipientDto recipient)
    {
        await Http.PutAsJsonAsync($"api/notifications/recipients/{recipient.Id}", recipient);
        await Load();
        await OnChanged.InvokeAsync();
    }

    private async Task ToggleActive(TelegramRecipientDto recipient, bool? isChecked)
    {
        recipient.IsActive = isChecked ?? false;
        await UpdateRecipient(recipient);
    }

    private async Task ToggleDefault(TelegramRecipientDto recipient, bool? isChecked)
    {
        if (isChecked == true)
        {
            foreach (var r in _recipients.Where(x => x.Id != recipient.Id))
            {
                r.IsDefault = false;
                await Http.PutAsJsonAsync($"api/notifications/recipients/{r.Id}", r);
            }

            recipient.IsDefault = true;
            await Http.PutAsJsonAsync($"api/notifications/recipients/{recipient.Id}", recipient);
        }
        else
        {
            recipient.IsDefault = false;
            await Http.PutAsJsonAsync($"api/notifications/recipients/{recipient.Id}", recipient);
        }

        await Load();
        await OnChanged.InvokeAsync();
    }

    private async Task DeleteRecipient(int id)
    {
        await Http.DeleteAsync($"api/notifications/recipients/{id}");
        await Load();
        await OnChanged.InvokeAsync();
    }

    private async Task OnRoleChanged(TelegramRecipientDto recipient, ChangeEventArgs args)
    {
        recipient.Role = args.Value?.ToString();
        await UpdateRecipient(recipient);
    }
}