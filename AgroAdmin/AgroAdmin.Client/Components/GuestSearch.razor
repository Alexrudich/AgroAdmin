@using AgroAdmin.Shared.Dto
<div class="guest-search-container">
    <div class="form-floating mb-2">
        <input type="text"
               class="form-control"
               placeholder="Поиск гостя"
               @bind="SearchTerm"
               @oninput="OnSearchInput"
               @onfocus="() => ShowDropdown = true"
               @onblur="HideDropdown" />
        <label>👤 Поиск гостя</label>
    </div>

    @if (IsSearching)
    {
        <div class="text-center p-2">
            <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
        </div>
    }

    @if (ShowDropdown && SearchResults?.Any() == true)
    {
        <div class="guest-dropdown mobile-dropdown">
            @foreach (var guest in SearchResults.Take(10))
            {
                <div class="guest-item @(SelectedGuest?.Id == guest.Id ? "selected" : "")"
                     @onmousedown="() => OnGuestSelected(guest)">
                    <div class="guest-avatar">@guest.FullName.Substring(0, 1).ToUpper()</div>
                    <div class="guest-info">
                        <div class="guest-name">@guest.FullName</div>
                        <div class="guest-phone">@guest.Phone</div>
                    </div>
                    <div class="guest-stats">
                        <span class="stay-badge">🏨 @guest.TotalStays</span>
                    </div>
                </div>
            }
        </div>
    }
</div>

@if (SelectedGuest != null)
{
    <div class="selected-guest-card">
        <div class="d-flex align-items-center gap-2">
            <div class="guest-avatar-lg">@SelectedGuest.FullName.Substring(0, 1).ToUpper()</div>
            <div class="flex-grow-1">
                <div class="fw-bold">@SelectedGuest.FullName</div>
                <div class="text-muted small">📞 @SelectedGuest.Phone</div>
                <span class="badge bg-info">Был @SelectedGuest.TotalStays раз(а)</span>
            </div>
            <button class="btn btn-sm btn-outline-secondary" @onclick="ClearGuest">✕</button>
        </div>
    </div>
}
else if (!string.IsNullOrWhiteSpace(SearchTerm) && !IsSearching && SearchTerm.Length >= 2 && SearchResults != null && !SearchResults.Any())
{
    <div class="alert alert-info mt-2 py-2">
        <i class="bi bi-info-circle"></i> Новый гость
    </div>
}

@code {
    [Parameter] public string SearchTerm { get; set; } = "";
    [Parameter] public EventCallback<string> SearchTermChanged { get; set; }
    [Parameter] public List<GuestDto> SearchResults { get; set; } = new();
    [Parameter] public GuestDto? SelectedGuest { get; set; }
    [Parameter] public EventCallback<GuestDto> SelectedGuestChanged { get; set; }
    [Parameter] public bool IsSearching { get; set; }
    [Parameter] public bool ShowDropdown { get; set; }
    [Parameter] public EventCallback<bool> ShowDropdownChanged { get; set; }
    [Parameter] public EventCallback OnClearGuest { get; set; }

    private async Task OnSearchInput(ChangeEventArgs e)
    {
        SearchTerm = e.Value?.ToString() ?? "";
        await SearchTermChanged.InvokeAsync(SearchTerm);
    }

    private async Task OnGuestSelected(GuestDto guest)
    {
        await SelectedGuestChanged.InvokeAsync(guest);
        ShowDropdown = false;
        await ShowDropdownChanged.InvokeAsync(false);
    }

    private async Task HideDropdown()
    {
        await Task.Delay(200);
        ShowDropdown = false;
        await ShowDropdownChanged.InvokeAsync(false);
    }

    private async Task ClearGuest()
    {
        await OnClearGuest.InvokeAsync();
    }
}