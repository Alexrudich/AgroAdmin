@page "/calendar"
@using System.Globalization
@using AgroAdmin.Shared.Dto.Auth
@using AgroAdmin.Shared.Dto.Bookings.Responses
@inject HttpClient Http
@inject NavigationManager Nav

<PageTitle>Шахматка усадьбы</PageTitle>

<div class="container-fluid mt-4">
    @* Навигация по месяцам *@
    <div class="month-navigation-container">
        <div class="month-navigation">
            <button class="month-nav-btn" @onclick="PreviousMonth">←</button>

            <div class="month-selector" @onclick="ToggleMonthPicker">
                <span class="current-month-display">@_currentMonth.ToString("MMMM yyyy")</span>
                <span class="dropdown-icon">▼</span>
            </div>

            <button class="month-nav-btn" @onclick="NextMonth">→</button>

            @if (_currentMonth.ToString("yyyyMM") != DateTime.Now.ToString("yyyyMM"))
            {
                <button class="today-nav-btn" @onclick="GoToToday" title="Сегодня">
                    <span>📅</span>
                </button>
            }
        </div>

        @if (_showMonthPicker)
        {
            <div class="month-picker-dropdown">
                <div class="month-picker-header">
                    <button class="month-picker-nav" @onclick="DecrementYear">←</button>
                    <span class="month-picker-year">@_pickerYear</span>
                    <button class="month-picker-nav" @onclick="IncrementYear">→</button>
                </div>
                <div class="month-picker-grid">
                    @for (var i = 0; i < 12; i++)
                    {
                        var monthNum = i + 1;
                        var monthDate = new DateTime(_pickerYear, monthNum, 1);
                        var isCurrent = _currentMonth.Year == _pickerYear && _currentMonth.Month == monthNum;
                        <div class="month-picker-item @(isCurrent ? "selected" : "")"
                             @onclick="() => SelectMonth(monthNum)">
                            @CultureInfo.CurrentCulture.DateTimeFormat.GetAbbreviatedMonthName(monthNum)
                        </div>
                    }
                </div>
            </div>
        }
    </div>

    @if (_allBookings == null)
    {
        <div class="d-flex justify-content-center p-5">
            <div class="spinner-border text-primary" role="status"></div>
        </div>
    }
    else
    {
        <div class="calendar-grid shadow-sm">
            <div class="calendar-header">
                @foreach (var day in GetSortedDaysOfWeek())
                {
                    <div class="header-cell">@GetRussianDayName(day)</div>
                }
            </div>

            <div class="calendar-body">
                @foreach (var date in _calendarDays)
                {
                    var dayBookings = GetBookingsForDate(date);
                    var pond = dayBookings.FirstOrDefault(b => b.ReservedUnit == ReservedUnits.PondSide);
                    var park = dayBookings.FirstOrDefault(b => b.ReservedUnit == ReservedUnits.ParkingSide);
                    var whole = dayBookings.FirstOrDefault(b => b.ReservedUnit == ReservedUnits.WholeHouse);

                    <div class="calendar-cell @(date.Date == DateTime.Today ? "is-today" : "") @(date.Month != _currentMonth.Month ? "other-month" : "")"
                         @onclick="() => ToggleMarquee(date)">

                        <div class="date-number">@date.Day</div>

                        @if (whole != null)
                        {
                            <div class="unit-zone full-house"
                                 @onclick:stopPropagation="true"
                                 @onclick="() => OnCellClick(date, whole)">
                                <div class="marquee-wrapper">
                                    <div class="marquee-content @(IsMarqueeActive(date) ? "active" : "")">
                                        <span class="unit-text">🏠 @whole.Guest?.FullName</span>
                                    </div>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="unit-zone @(pond != null ? "busy" : "free")"
                                 @onclick:stopPropagation="true"
                                 @onclick="() => OnCellClick(date, pond, ReservedUnits.PondSide)">
                                <div class="marquee-wrapper">
                                    <div class="marquee-content @(IsMarqueeActive(date) ? "active" : "")">
                                        <span class="unit-text">
                                            @(pond != null ? $"🌊 {pond.Guest?.FullName}" : "🌊 Пруд (свободно)")
                                        </span>
                                    </div>
                                </div>
                            </div>

                            <div class="unit-zone @(park != null ? "busy" : "free")"
                                 @onclick:stopPropagation="true"
                                 @onclick="() => OnCellClick(date, park, ReservedUnits.ParkingSide)">
                                <div class="marquee-wrapper">
                                    <div class="marquee-content @(IsMarqueeActive(date) ? "active" : "")">
                                        <span class="unit-text">
                                            @(park != null ? $"🚗 {park.Guest?.FullName}" : "🚗 Парк (свободно)")
                                        </span>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    }
</div>

@code {
    private List<BookingDto>? _allBookings;
    private readonly List<DateTime> _calendarDays = new();
    private string? _activeMarqueeDate;
    private DateTime _currentMonth = DateTime.Now;
    private bool _showMonthPicker = false;
    private int _pickerYear = DateTime.Now.Year;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var status = await Http.GetFromJsonAsync<AuthStatusDto>("api/auth/status");
            if (status?.IsAuthenticated != true)
            {
                Nav.NavigateTo("/login", true);
                return;
            }
        }
        catch
        {
            Nav.NavigateTo("/login", true);
            return;
        }

        await LoadData();
    }

    private async Task LoadData()
    {
        try
        {
            var result = await Http.GetFromJsonAsync<PagedResultDto<BookingDto>>("api/bookings");
            _allBookings = result?.Items ?? new();
            GenerateCalendar(_currentMonth.Year, _currentMonth.Month);
        }
        catch
        {
            _allBookings = new();
            GenerateCalendar(_currentMonth.Year, _currentMonth.Month);
        }
    }

    private void GenerateCalendar(int year, int month)
    {
        _calendarDays.Clear();
        var firstDayOfMonth = new DateTime(year, month, 1);
        var offset = ((int)firstDayOfMonth.DayOfWeek == 0) ? 6 : (int)firstDayOfMonth.DayOfWeek - 1;

        for (var i = 0; i < 42; i++)
        {
            _calendarDays.Add(firstDayOfMonth.AddDays(i - offset));
        }
        StateHasChanged();
    }

    private void PreviousMonth()
    {
        _currentMonth = _currentMonth.AddMonths(-1);
        GenerateCalendar(_currentMonth.Year, _currentMonth.Month);
        _showMonthPicker = false;
    }

    private void NextMonth()
    {
        _currentMonth = _currentMonth.AddMonths(1);
        GenerateCalendar(_currentMonth.Year, _currentMonth.Month);
        _showMonthPicker = false;
    }

    private void GoToToday()
    {
        _currentMonth = DateTime.Now;
        GenerateCalendar(_currentMonth.Year, _currentMonth.Month);
        _showMonthPicker = false;
    }

    private void ToggleMonthPicker()
    {
        _showMonthPicker = !_showMonthPicker;
        if (_showMonthPicker)
        {
            _pickerYear = _currentMonth.Year;
        }
    }

    private void DecrementYear()
    {
        _pickerYear--;
    }

    private void IncrementYear()
    {
        _pickerYear++;
    }

    private void SelectMonth(int month)
    {
        try
        {
            if (month < 1 || month > 12) return;

            _currentMonth = new DateTime(_pickerYear, month, 1);
            GenerateCalendar(_currentMonth.Year, _currentMonth.Month);
            _showMonthPicker = false;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Ошибка выбора месяца: {ex.Message}");
        }
    }

    private bool IsMarqueeActive(DateTime date)
    {
        var key = date.ToString("yyyyMMdd");
        return _activeMarqueeDate == key;
    }

    private void ToggleMarquee(DateTime date)
    {
        var key = date.ToString("yyyyMMdd");

        if (_activeMarqueeDate == key)
        {
            _activeMarqueeDate = null;
        }
        else
        {
            _activeMarqueeDate = key;
            _ = Task.Delay(10000).ContinueWith(_ =>
            {
                InvokeAsync(() =>
                {
                    if (_activeMarqueeDate == key)
                    {
                        _activeMarqueeDate = null;
                        StateHasChanged();
                    }
                });
            });
        }
        StateHasChanged();
    }

    private void OnCellClick(DateTime date, BookingDto? b, ReservedUnits? unit = null)
    {
        if (b != null)
        {
            Nav.NavigateTo($"/bookings/edit/{b.Id}");
        }
        else
        {
            var unitVal = (int)(unit ?? ReservedUnits.WholeHouse);
            Nav.NavigateTo($"/bookings/create?start={date:yyyy-MM-dd}&unit={unitVal}");
        }
    }

    private List<BookingDto> GetBookingsForDate(DateTime d) =>
        _allBookings?
            .Where(b => d.Date >= b.ArrivalDate.Date && d.Date < b.DepartureDate.Date)
            .ToList() ?? new();

    private static IEnumerable<DayOfWeek> GetSortedDaysOfWeek() =>
        Enum.GetValues<DayOfWeek>()
            .Cast<DayOfWeek>()
            .OrderBy(d => (int)d == 0 ? 7 : (int)d);

    private static string GetRussianDayName(DayOfWeek d) => d switch
    {
        DayOfWeek.Monday => "Пн",
        DayOfWeek.Tuesday => "Вт",
        DayOfWeek.Wednesday => "Ср",
        DayOfWeek.Thursday => "Чт",
        DayOfWeek.Friday => "Пт",
        DayOfWeek.Saturday => "Сб",
        DayOfWeek.Sunday => "Вс",
        _ => ""
    };
}