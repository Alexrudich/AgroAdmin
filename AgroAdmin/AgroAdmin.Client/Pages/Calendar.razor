@page "/calendar"
@using AgroAdmin.Shared.Dto
@using AgroAdmin.Shared.Enums
@inject HttpClient Http
@inject NavigationManager Nav

<PageTitle>Шахматка усадьбы</PageTitle>

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold">📅 Занятость: @DateTime.Now.ToString("MMMM yyyy")</h2>
    </div>

    @if (allBookings == null)
    {
        <div class="d-flex justify-content-center p-5">
            <div class="spinner-border text-primary" role="status"></div>
        </div>
    }
    else
    {
        <div class="calendar-grid shadow-sm">
            @* Шапка дней недели *@
            <div class="calendar-header">
                @foreach (var day in GetSortedDaysOfWeek())
                {
                    <div class="header-cell">@GetRussianDayName(day)</div>
                }
            </div>

            @* Сетка календаря *@
            <div class="calendar-body">
                @foreach (var date in calendarDays)
                {
                    var dayBookings = GetBookingsForDate(date);
                    var pond = dayBookings.FirstOrDefault(b => b.ReservedUnit == ReservedUnits.PondSide);
                    var park = dayBookings.FirstOrDefault(b => b.ReservedUnit == ReservedUnits.ParkingSide);
                    var whole = dayBookings.FirstOrDefault(b => b.ReservedUnit == ReservedUnits.WholeHouse);

                     <div class="calendar-cell @(date.Date == DateTime.Today ? "is-today" : "") @(date.Month != DateTime.Now.Month ? "other-month" : "")">
                        <div class="date-number">@date.Day</div>

                        <div class="units-container">
                            @if (whole != null)
                            {
                                <div class="unit-zone full-house" @onclick="() => OnCellClick(date, whole)">
                                    <span class="unit-text">🏠 Весь дом: @whole.GuestName</span>
                                </div>
                            }
                            else
                            {
                                @* Зона Пруда *@
                                <div class="unit-zone @(pond != null ? "busy" : "free")"
                                     @onclick="() => OnCellClick(date, pond)">
                                    <span class="unit-text">
                                        @(pond != null ? $"🌊 {pond.GuestName}" : "🌊 Пруд (свободно)")
                                    </span>
                                </div>

                                @* Зона Парковки *@
                                <div class="unit-zone @(park != null ? "busy" : "free")"
                                     @onclick="() => OnCellClick(date, park)">
                                    <span class="unit-text">
                                        @(park != null ? $"🚗 {park.GuestName}" : "🚗 Парк (свободно)")
                                    </span>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>

@code {
    private List<BookingDto>? allBookings;
    private List<DateTime> calendarDays = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            allBookings = await Http.GetFromJsonAsync<List<BookingDto>>("api/bookings");
            GenerateCalendar(DateTime.Now.Year, DateTime.Now.Month);
        }
        catch { allBookings = new(); }
    }

    private void GenerateCalendar(int year, int month)
    {
        var first = new DateTime(year, month, 1);
        int offset = ((int)first.DayOfWeek == 0) ? 6 : (int)first.DayOfWeek - 1;
        calendarDays.Clear();
        for (int i = 0; i < 42; i++) calendarDays.Add(first.AddDays(i - offset));
    }

    private void OnCellClick(DateTime date, BookingDto? b)
    {
        if (b != null) Nav.NavigateTo($"/bookings/edit/{b.Id}");
        else Nav.NavigateTo($"/bookings/create?start={date.ToString("yyyy-MM-dd")}");
    }

    private List<BookingDto> GetBookingsForDate(DateTime d) =>
        allBookings?.Where(b => d.Date >= b.ArrivalDate.Date && d.Date < b.DepartureDate.Date).ToList() ?? new();

    private IEnumerable<DayOfWeek> GetSortedDaysOfWeek() =>
        Enum.GetValues<DayOfWeek>().Cast<DayOfWeek>().OrderBy(d => (int)d == 0 ? 7 : (int)d);

    private string GetRussianDayName(DayOfWeek d) => d switch
    {
        DayOfWeek.Monday => "Пн",
        DayOfWeek.Tuesday => "Вт",
        DayOfWeek.Wednesday => "Ср",
        DayOfWeek.Thursday => "Чт",
        DayOfWeek.Friday => "Пт",
        DayOfWeek.Saturday => "Сб",
        DayOfWeek.Sunday => "Вс",
        _ => ""
    };
}
