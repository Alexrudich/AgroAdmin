@page "/calendar"
@using System.Globalization
@using AgroAdmin.Shared.Dto.Auth
@using AgroAdmin.Shared.Dto.Bookings.Responses
@inject HttpClient Http
@inject NavigationManager Nav

<PageTitle>Шахматка усадьбы</PageTitle>

<div class="container-fluid mt-4">
    @* Навигация по месяцам *@
    <div class="month-navigation-container">
        <div class="month-navigation">
            <button class="month-nav-btn" @onclick="PreviousMonth">←</button>

            <div class="month-selector" @onclick="ToggleMonthPicker">
                <span class="current-month-display">@_currentMonth.ToString("MMMM yyyy")</span>
                <span class="dropdown-icon">▼</span>
            </div>

            <button class="month-nav-btn" @onclick="NextMonth">→</button>

            @if (_currentMonth.ToString("yyyyMM") != DateTime.Now.ToString("yyyyMM"))
            {
                <button class="today-nav-btn" @onclick="GoToToday" title="Сегодня">
                    <span>📅</span>
                </button>
            }
        </div>

        @if (_showMonthPicker)
        {
            <div class="month-picker-dropdown">
                <div class="month-picker-header">
                    <button class="month-picker-nav" @onclick="DecrementYear">←</button>
                    <span class="month-picker-year">@_pickerYear</span>
                    <button class="month-picker-nav" @onclick="IncrementYear">→</button>
                </div>
                <div class="month-picker-grid">
                    @for (var i = 0; i < 12; i++)
                    {
                        var monthNum = i + 1;
                        var monthDate = new DateTime(_pickerYear, monthNum, 1);
                        var isCurrent = _currentMonth.Year == _pickerYear && _currentMonth.Month == monthNum;
                        <div class="month-picker-item @(isCurrent ? "selected" : "")"
                             @onclick="() => SelectMonth(monthNum)">
                            @CultureInfo.CurrentCulture.DateTimeFormat.GetAbbreviatedMonthName(monthNum)
                        </div>
                    }
                </div>
            </div>
        }
    </div>

    @if (_allBookings == null)
    {
        <div class="d-flex justify-content-center p-5">
            <div class="spinner-border text-primary" role="status"></div>
        </div>
    }
    else
    {
        <div class="calendar-grid shadow-sm">
            <div class="calendar-header">
                @foreach (var day in GetSortedDaysOfWeek())
                {
                    <div class="header-cell">@GetRussianDayName(day)</div>
                }
            </div>

            <div class="calendar-body">
                @foreach (var date in _calendarDays)
                {
                    var dayBookings = GetBookingsForDate(date);
                    var pond = dayBookings.FirstOrDefault(b => b.ReservedUnit == ReservedUnits.PondSide);
                    var park = dayBookings.FirstOrDefault(b => b.ReservedUnit == ReservedUnits.ParkingSide);
                    var whole = dayBookings.FirstOrDefault(b => b.ReservedUnit == ReservedUnits.WholeHouse);

                    <div class="calendar-cell @(date.Date == DateTime.Today ? "is-today" : "") @(date.Month != _currentMonth.Month ? "other-month" : "")"
                         @onclick="() => HandleMobileCellClick(date, dayBookings)">

                        <div class="date-number">@date.Day</div>

                        <div class="units-container">
                            @if (whole != null)
                            {
                                <div class="unit-zone full-house"
                                     @onclick:stopPropagation="true"
                                     @onclick="() => OnCellClick(date, whole)">
                                    <span class="unit-icon">🏠</span>
                                    <span class="unit-text d-none d-md-inline"> @whole.Guest?.FullName</span>
                                </div>
                            }
                            else
                            {
                                // Пруд - показываем только если занят
                                @if (pond != null)
                                {
                                    <div class="unit-zone busy"
                                         @onclick:stopPropagation="true"
                                         @onclick="() => OnCellClick(date, pond)">
                                        <span class="unit-icon">🌊</span>
                                        <span class="unit-text d-none d-md-inline"> @pond.Guest?.FullName</span>
                                    </div>
                                }
                                else
                                {
                                    // Свободный слот - показываем пустую область (но с классом free для стилей)
                                    <div class="unit-zone free"
                                         @onclick:stopPropagation="true"
                                         @onclick="() => OnCellClick(date, null, ReservedUnits.PondSide)">
                                        <span class="unit-text d-none d-md-inline">Свободно</span>
                                    </div>
                                }

                                // Парковка - показываем только если занят
                                @if (park != null)
                                {
                                    <div class="unit-zone busy"
                                         @onclick:stopPropagation="true"
                                         @onclick="() => OnCellClick(date, park)">
                                        <span class="unit-icon">🚗</span>
                                        <span class="unit-text d-none d-md-inline"> @park.Guest?.FullName</span>
                                    </div>
                                }
                                else
                                {
                                    // Свободный слот - показываем пустую область (но с классом free для стилей)
                                    <div class="unit-zone free"
                                         @onclick:stopPropagation="true"
                                         @onclick="() => OnCellClick(date, null, ReservedUnits.ParkingSide)">
                                        <span class="unit-text d-none d-md-inline">Свободно</span>
                                    </div>
                                }
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>

@* Всплывающее меню выбора (Action Sheet) *@
@if (_selectedDateForAction.HasValue)
{
    var selDate = _selectedDateForAction.Value;
    var bookings = GetBookingsForDate(selDate);

    <div class="mobile-action-sheet" @onclick="() => _selectedDateForAction = null">
        <div class="sheet-content" @onclick:stopPropagation="true">
            <div class="sheet-header">
                <h5 class="m-0">@selDate.ToString("dd MMMM")</h5>
                <button type="button" class="btn-close" @onclick="() => _selectedDateForAction = null"></button>
            </div>
            <div class="list-group mt-3">
                @foreach (var b in bookings)
                {
                    <button type="button" class="list-group-item list-group-item-action d-flex align-items-center"
                            @onclick="() => { OnCellClick(selDate, b); _selectedDateForAction = null; }">
                        <span class="me-3">@(b.ReservedUnit == ReservedUnits.PondSide ? "🌊" : b.ReservedUnit == ReservedUnits.ParkingSide ? "🚗" : "🏠")</span>
                        <div class="flex-grow-1">
                            <div class="fw-bold">@b.Guest?.FullName</div>
                            <small class="text-muted">@(b.ReservedUnit == ReservedUnits.PondSide ? "Пруд" : b.ReservedUnit == ReservedUnits.ParkingSide ? "Парковка" : "Весь дом")</small>
                        </div>
                    </button>
                }

                @if (bookings.Count < 2 && bookings.All(x => x.ReservedUnit != ReservedUnits.WholeHouse))
                {
                    <div class="mt-2 pt-2 border-top">
                        @* 1. Если день совсем пустой — предлагаем Весь дом как приоритет *@
                        @if (bookings.Count == 0)
                        {
                            <button type="button" class="list-group-item list-group-item-action text-primary"
                                    @onclick="() => { OnCellClick(selDate, null, ReservedUnits.WholeHouse); _selectedDateForAction = null; }">
                                🏠 Забронировать весь дом
                            </button>
                        }

                        @* 2. Половинка у Пруда (показываем, если она не занята и не забронирован весь дом) *@
                        @if (bookings.All(x => x.ReservedUnit != ReservedUnits.PondSide))
                        {
                            <button type="button" class="list-group-item list-group-item-action text-primary"
                                    @onclick="() => { OnCellClick(selDate, null, ReservedUnits.PondSide); _selectedDateForAction = null; }">
                                🌊 Забронировать половинку у пруда
                            </button>
                        }

                        @* 3. Половинка у Парковки *@
                        @if (bookings.All(x => x.ReservedUnit != ReservedUnits.ParkingSide))
                        {
                            <button type="button" class="list-group-item list-group-item-action text-primary"
                                    @onclick="() => { OnCellClick(selDate, null, ReservedUnits.ParkingSide); _selectedDateForAction = null; }">
                                🚗 Забронировать половинку у парковки
                            </button>
                        }
                    </div>
                }

            </div>
        </div>
    </div>
}

@code {
    private List<BookingDto>? _allBookings;
    private readonly List<DateTime> _calendarDays = new();
    private DateTime _currentMonth = DateTime.Now;
    private bool _showMonthPicker = false;
    private int _pickerYear = DateTime.Now.Year;

    // Поле для управления мобильным меню
    private DateTime? _selectedDateForAction;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var status = await Http.GetFromJsonAsync<AuthStatusDto>("api/auth/status");
            if (status?.IsAuthenticated != true)
            {
                Nav.NavigateTo("/login", true);
                return;
            }
        }
        catch
        {
            Nav.NavigateTo("/login", true);
            return;
        }

        await LoadData();
    }

    private async Task LoadData()
    {
        try
        {
            // Здесь можно добавить фильтрацию по датам, чтобы не тянуть все брони за все время
            var result = await Http.GetFromJsonAsync<PagedResultDto<BookingDto>>("api/bookings");
            _allBookings = result?.Items ?? new();
            GenerateCalendar(_currentMonth.Year, _currentMonth.Month);
        }
        catch
        {
            _allBookings = new();
            GenerateCalendar(_currentMonth.Year, _currentMonth.Month);
        }
    }

    private void GenerateCalendar(int year, int month)
    {
        _calendarDays.Clear();
        var firstDayOfMonth = new DateTime(year, month, 1);
        // Вычисляем отступ, чтобы неделя начиналась с понедельника
        var offset = ((int)firstDayOfMonth.DayOfWeek == 0) ? 6 : (int)firstDayOfMonth.DayOfWeek - 1;

        for (var i = 0; i < 42; i++)
        {
            _calendarDays.Add(firstDayOfMonth.AddDays(i - offset));
        }
        StateHasChanged();
    }

    // --- Навигация по календарю ---

    private void PreviousMonth()
    {
        _currentMonth = _currentMonth.AddMonths(-1);
        GenerateCalendar(_currentMonth.Year, _currentMonth.Month);
        _showMonthPicker = false;
    }

    private void NextMonth()
    {
        _currentMonth = _currentMonth.AddMonths(1);
        GenerateCalendar(_currentMonth.Year, _currentMonth.Month);
        _showMonthPicker = false;
    }

    private void GoToToday()
    {
        _currentMonth = DateTime.Now;
        GenerateCalendar(_currentMonth.Year, _currentMonth.Month);
        _showMonthPicker = false;
    }

    private void ToggleMonthPicker()
    {
        _showMonthPicker = !_showMonthPicker;
        if (_showMonthPicker) _pickerYear = _currentMonth.Year;
    }

    private void DecrementYear() => _pickerYear--;
    private void IncrementYear() => _pickerYear++;

    private void SelectMonth(int month)
    {
        if (month < 1 || month > 12) return;
        _currentMonth = new DateTime(_pickerYear, month, 1);
        GenerateCalendar(_currentMonth.Year, _currentMonth.Month);
        _showMonthPicker = false;
    }

    // --- Логика кликов и переходов ---

    // Основной метод перехода (используется и в ячейках, и в меню)
    private void OnCellClick(DateTime date, BookingDto? b, ReservedUnits? unit = null)
    {
        if (b != null)
        {
            Nav.NavigateTo($"/bookings/edit/{b.Id}");
        }
        else
        {
            var unitVal = (int)(unit ?? ReservedUnits.WholeHouse);
            Nav.NavigateTo($"/bookings/create?start={date:yyyy-MM-dd}&unit={unitVal}");
        }
    }

    // Метод для мобильной версии: просто открывает меню выбора
    private void HandleMobileCellClick(DateTime date, List<BookingDto> bookings)
    {
        _selectedDateForAction = date;
    }

    // --- Вспомогательные методы ---

    private List<BookingDto> GetBookingsForDate(DateTime d) =>
        _allBookings?
            .Where(b => d.Date >= b.ArrivalDate.Date && d.Date < b.DepartureDate.Date)
            .ToList() ?? new();

    private static IEnumerable<DayOfWeek> GetSortedDaysOfWeek() =>
        Enum.GetValues<DayOfWeek>()
            .Cast<DayOfWeek>()
            .OrderBy(d => (int)d == 0 ? 7 : (int)d);

    private static string GetRussianDayName(DayOfWeek d) => d switch
    {
        DayOfWeek.Monday => "Пн",
        DayOfWeek.Tuesday => "Вт",
        DayOfWeek.Wednesday => "Ср",
        DayOfWeek.Thursday => "Чт",
        DayOfWeek.Friday => "Пт",
        DayOfWeek.Saturday => "Сб",
        DayOfWeek.Sunday => "Вс",
        _ => ""
    };
}