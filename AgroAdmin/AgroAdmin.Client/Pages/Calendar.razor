@page "/calendar"
@using System.Globalization
@using AgroAdmin.Shared.Dto.Auth
@using AgroAdmin.Shared.Dto.Bookings.Responses
@using AgroAdmin.Shared.Extensions
@inject HttpClient Http
@inject NavigationManager Nav
@inject IJSRuntime JSRuntime

<PageTitle>Шахматка усадьбы</PageTitle>

<div class="container-fluid mt-4">
    <div class="month-navigation-container">
        <div class="month-navigation">
            <button class="month-nav-btn" @onclick="PreviousMonth">←</button>
            <div class="month-selector" @onclick="ToggleMonthPicker">
                <span class="current-month-display">@_currentMonth.ToString("MMMM yyyy")</span>
                <span class="dropdown-icon">▼</span>
            </div>
            <button class="month-nav-btn" @onclick="NextMonth">→</button>
            @if (_currentMonth.ToString("yyyyMM") != DateTime.Now.ToString("yyyyMM"))
            {
                <button class="today-nav-btn" @onclick="GoToToday" title="Сегодня">
                    <span>📅</span>
                </button>
            }
        </div>

        @if (_showMonthPicker)
        {
            <div class="month-picker-dropdown">
                <div class="month-picker-header">
                    <button class="month-picker-nav" @onclick="DecrementYear">←</button>
                    <span class="month-picker-year">@_pickerYear</span>
                    <button class="month-picker-nav" @onclick="IncrementYear">→</button>
                </div>
                <div class="month-picker-grid">
                    @for (var i = 0; i < 12; i++)
                    {
                        var monthNum = i + 1;
                        var isCurrent = _currentMonth.Year == _pickerYear && _currentMonth.Month == monthNum;
                        <div class="month-picker-item @(isCurrent ? "selected" : "")"
                             @onclick="() => SelectMonth(monthNum)">
                            @CultureInfo.CurrentCulture.DateTimeFormat.GetAbbreviatedMonthName(monthNum)
                        </div>
                    }
                </div>
            </div>
        }
    </div>

    @if (_allBookings == null)
    {
        <div class="d-flex justify-content-center p-5">
            <div class="spinner-border text-primary" role="status"></div>
        </div>
    }
    else
    {
        <div class="calendar-grid">
            <div class="calendar-header">
                @foreach (var day in GetSortedDaysOfWeek())
                {
                    <div class="header-cell">@GetRussianDayName(day)</div>
                }
            </div>

            <div class="calendar-body">
                @foreach (var date in _calendarDays)
                {
                    var dayBookings = GetBookingsForDate(date);
                    var pond = dayBookings.FirstOrDefault(b => b.ReservedUnit == ReservedUnits.PondSide);
                    var park = dayBookings.FirstOrDefault(b => b.ReservedUnit == ReservedUnits.ParkingSide);
                    var whole = dayBookings.FirstOrDefault(b => b.ReservedUnit == ReservedUnits.WholeHouse);
    
                    var isWholeOccupied = whole != null;
                    var isPondOccupied = pond != null;
                    var isParkOccupied = park != null;
                    var occupiedCount = (isPondOccupied ? 1 : 0) + (isParkOccupied ? 1 : 0);
    
                    // Определяем класс ячейки
                    string cellClass = "";
                    if (isWholeOccupied || occupiedCount == 2) cellClass = "cell-both";
                    else if (occupiedCount == 1) cellClass = "cell-one";
                    else cellClass = "cell-free";

                    <div class="calendar-cell @cellClass @(date.Month != _currentMonth.Month ? "other-month" : "")"
                         @onclick="() => HandleCellClick(date, dayBookings)">
                        <div class="date-number">@date.Day</div>
        
                        @if (!isWholeOccupied && occupiedCount > 0)
                        {
                            <div class="mobile-badge-container">
                                @if (isPondOccupied)
                                {
                                    <div class="badge badge-pond">Пруд</div>
                                }
                                @if (isParkOccupied)
                                {
                                    <div class="badge badge-park">Парковка</div>
                                }
                            </div>
                        }
                        @if (isWholeOccupied)
                        {
                            <div class="mobile-badge-container">
                                <div class="badge badge-whole">Дом</div>
                            </div>
                        }
                    </div>
                }
                </div>
        </div>
    }
</div>

@* Модалка *@
@if (_selectedDate.HasValue)
{
    var selDate = _selectedDate.Value;
    var bookings = GetBookingsForDate(selDate);
    var pond = bookings.FirstOrDefault(b => b.ReservedUnit == ReservedUnits.PondSide);
    var park = bookings.FirstOrDefault(b => b.ReservedUnit == ReservedUnits.ParkingSide);
    var whole = bookings.FirstOrDefault(b => b.ReservedUnit == ReservedUnits.WholeHouse);

    var isWholeOccupied = whole != null;
    var isPondOccupied = pond != null;
    var isParkOccupied = park != null;
    var hasFreeSlots = !isWholeOccupied && (!isPondOccupied || !isParkOccupied);

    <div class="modal-overlay" @onclick="CloseModal">
        <div class="modal-content" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h5>@selDate.ToString("dd MMMM yyyy")</h5>
                <button class="modal-close" @onclick="CloseModal">×</button>
            </div>
            <div class="modal-body">
                @if (bookings.Any())
                {
                    @foreach (var b in bookings)
                    {
                        <div class="booking-card" @onclick="() => OnEditBooking(b)">
                            <div class="booking-title">
                                <span class="booking-badge @(b.ReservedUnit == ReservedUnits.PondSide ? "badge-pond" : b.ReservedUnit == ReservedUnits.ParkingSide ? "badge-park" : "badge-whole")">
                                    @(b.ReservedUnit == ReservedUnits.PondSide ? "Пруд" : b.ReservedUnit == ReservedUnits.ParkingSide ? "Парковка" : "Дом")
                                </span>
                                <span class="booking-name">@b.Guest?.FullName</span>
                            </div>
                            <div class="booking-details">
                                👥 @b.TotalGuestsCount чел.
                                @if (b.NeedsSauna)
                                {
                                    <text>🌡️ Сауна</text>
                                }
                                @if (b.NeedsBanquetHall)
                                {
                                    <text>🥂 Зал</text>
                                }
                                @if (b.HasDog)
                                {
                                    <text>🐕 Собака</text>
                                }
                            </div>
                        </div>
                    }
                }

                @if (hasFreeSlots)
                {
                    <div class="create-section">
                        <div class="create-title">Создать бронь:</div>
                        @if (!isPondOccupied)
                        {
                            <button class="create-btn create-pond" @onclick="() => OnCreateBooking(selDate, ReservedUnits.PondSide)">
                                🌊 Пруд
                            </button>
                        }
                        @if (!isParkOccupied)
                        {
                            <button class="create-btn create-park" @onclick="() => OnCreateBooking(selDate, ReservedUnits.ParkingSide)">
                                🚗 Парковка
                            </button>
                        }
                        @if (!isPondOccupied && !isParkOccupied)
                        {
                            <button class="create-btn create-whole" @onclick="() => OnCreateBooking(selDate, ReservedUnits.WholeHouse)">
                                🏠 Весь дом
                            </button>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
}
@code {
    private List<BookingDto>? _allBookings;
    private readonly List<DateTime> _calendarDays = new();
    private DateTime _currentMonth = DateTime.Now;
    private bool _showMonthPicker = false;
    private int _pickerYear = DateTime.Now.Year;
    private DateTime? _selectedDate;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var status = await Http.GetFromJsonAsync<AuthStatusDto>("api/auth/status");
            if (status?.IsAuthenticated != true)
            {
                Nav.NavigateTo("/login", true);
                return;
            }
        }
        catch
        {
            Nav.NavigateTo("/login", true);
            return;
        }

        await LoadData();
    }

    private async Task LoadData()
    {
        try
        {
            var result = await Http.GetFromJsonAsync<PagedResultDto<BookingDto>>("api/bookings");
            _allBookings = result?.Items ?? new();
            GenerateCalendar(_currentMonth.Year, _currentMonth.Month);
        }
        catch
        {
            _allBookings = new();
            GenerateCalendar(_currentMonth.Year, _currentMonth.Month);
        }
    }

    private void GenerateCalendar(int year, int month)
    {
        _calendarDays.Clear();
        var firstDayOfMonth = new DateTime(year, month, 1);
        var offset = ((int)firstDayOfMonth.DayOfWeek == 0) ? 6 : (int)firstDayOfMonth.DayOfWeek - 1;

        for (var i = 0; i < 42; i++)
        {
            _calendarDays.Add(firstDayOfMonth.AddDays(i - offset));
        }
        StateHasChanged();
    }

    private void PreviousMonth()
    {
        _currentMonth = _currentMonth.AddMonths(-1);
        GenerateCalendar(_currentMonth.Year, _currentMonth.Month);
        _showMonthPicker = false;
    }

    private void NextMonth()
    {
        _currentMonth = _currentMonth.AddMonths(1);
        GenerateCalendar(_currentMonth.Year, _currentMonth.Month);
        _showMonthPicker = false;
    }

    private void GoToToday()
    {
        _currentMonth = DateTime.Now;
        GenerateCalendar(_currentMonth.Year, _currentMonth.Month);
        _showMonthPicker = false;
    }

    private void ToggleMonthPicker()
    {
        _showMonthPicker = !_showMonthPicker;
        if (_showMonthPicker) _pickerYear = _currentMonth.Year;
    }

    private void DecrementYear() => _pickerYear--;
    private void IncrementYear() => _pickerYear++;

    private void SelectMonth(int month)
    {
        if (month < 1 || month > 12) return;
        _currentMonth = new DateTime(_pickerYear, month, 1);
        GenerateCalendar(_currentMonth.Year, _currentMonth.Month);
        _showMonthPicker = false;
    }

    private void HandleCellClick(DateTime date, List<BookingDto> bookings)
    {
        _selectedDate = date;
        StateHasChanged();
    }

    private void OnEditBooking(BookingDto booking)
    {
        Nav.NavigateTo($"/bookings/edit/{booking.Id}");
    }

    private void OnCreateBooking(DateTime date, ReservedUnits unit)
    {
        Nav.NavigateTo($"/bookings/create?start={date:yyyy-MM-dd}&unit={(int)unit}");
    }

    private void CloseModal()
    {
        _selectedDate = null;
        StateHasChanged();
    }

    private List<BookingDto> GetBookingsForDate(DateTime d) =>
        _allBookings?
            .Where(b => d.Date >= b.ArrivalDate.Date && d.Date < b.DepartureDate.Date)
            .ToList() ?? new();

    private static IEnumerable<DayOfWeek> GetSortedDaysOfWeek() =>
        Enum.GetValues<DayOfWeek>()
            .Cast<DayOfWeek>()
            .OrderBy(d => (int)d == 0 ? 7 : (int)d);

    private static string GetRussianDayName(DayOfWeek d) => d switch
    {
        DayOfWeek.Monday => "Пн",
        DayOfWeek.Tuesday => "Вт",
        DayOfWeek.Wednesday => "Ср",
        DayOfWeek.Thursday => "Чт",
        DayOfWeek.Friday => "Пт",
        DayOfWeek.Saturday => "Сб",
        DayOfWeek.Sunday => "Вс",
        _ => ""
    };
}