@page "/guests/create"
@page "/guests/edit/{Id:int}"
@using AgroAdmin.Shared.Dto
@inject HttpClient Http
@inject NavigationManager Nav

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow">
                <div class="card-header bg-primary text-white">
                    <h3 class="mb-0">@(Id.HasValue ? "✏️ Редактирование гостя" : "✨ Новый гость")</h3>
                </div>
                <div class="card-body">
                    <EditForm Model="@guest" OnValidSubmit="HandleSubmit">
                        <DataAnnotationsValidator />
                        <ValidationSummary class="text-danger" />

                        <div class="mb-3">
                            <label class="form-label fw-bold">Имя *</label>
                            <InputText @bind-Value="guest.FullName" class="form-control" />
                            <ValidationMessage For="@(() => guest.FullName)" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Телефон *</label>
                            <InputText @bind-Value="guest.Phone" class="form-control" placeholder="+375..." />
                            <ValidationMessage For="@(() => guest.Phone)" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Комментарий</label>
                            <InputTextArea @bind-Value="guest.Comment" class="form-control" rows="3"
                                           placeholder="Особые отметки, пожелания..." />
                        </div>

                        <div class="d-flex justify-content-between border-top pt-3">
                            <button type="button" class="btn btn-outline-secondary" @onclick='() => Nav.NavigateTo("/guests")'>
                                Отмена
                            </button>
                            <button type="submit" class="btn btn-success">
                                @(Id.HasValue ? "Сохранить" : "Создать")
                            </button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter] public int? Id { get; set; }
    private GuestDto guest = new();

    protected override async Task OnInitializedAsync()
    {
        if (Id.HasValue)
        {
            try
            {
                guest = await Http.GetFromJsonAsync<GuestDto>($"api/guests/{Id}") ?? new();
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Ошибка загрузки: {ex.Message}");
            }
        }
    }

    private async Task HandleSubmit()
    {
        try
        {
            HttpResponseMessage response;

            if (Id.HasValue)
            {
                response = await Http.PutAsJsonAsync($"api/guests/{Id}", guest);
            }
            else
            {
                response = await Http.PostAsJsonAsync("api/guests", guest);
            }

            if (response.IsSuccessStatusCode)
            {
                Nav.NavigateTo("/guests");
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                Console.WriteLine($"Ошибка: {error}");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Ошибка: {ex.Message}");
        }
    }
}