@page "/bookings/create"
@page "/bookings/edit/{Id:int}"
@implements IDisposable
@using AgroAdmin.Client.Components.Calendar;
@inject BookingFormService Service
@inject NavigationManager Nav

<div class="container-fluid p-3">
    <div class="card shadow">
        <div class="card-header bg-primary text-white py-2">
            <h5 class="mb-0">@(Id.HasValue ? "✏️ Редактирование" : "✨ Новое бронирование")</h5>
        </div>

        <div class="card-body p-3">
            <EditForm Model="@Service.Booking" OnValidSubmit="HandleSubmit">

                <!-- 1️-3️ Поиск и карточка гостя -->
                <GuestSearchSection Service="Service" />

                <!-- 4️ Даты и объект -->
                <BookingDatesSection Service="Service"
                                     OnDateChanged="OnDateChanged"
                                     OnUnitChanged="OnUnitChanged" />

                <!-- 5️ Состав гостей -->
                <GuestCompositionSection Service="Service" />

                <!-- 6️ Опции -->
                <BookingOptionsSection Service="Service" />

                <!-- 7️ Заметки -->
                <BookingNotesSection Service="Service" />

                <!-- 8️ Валидация -->
                <BookingValidation Errors="_validationErrors"
                                   EarliestAvailableDate="_earliestAvailableDate"
                                   IsValidating="_isValidating" />

                <!-- 9️ Кнопки -->
                <BookingFormActions Id="Id"
                                    OnCancel="Cancel"
                                    IsValidating="_isValidating" />

            </EditForm>
        </div>
    </div>
</div>

@code {
    [Parameter] public int? Id { get; set; }

    private List<string> _validationErrors = new();
    private DateTime? _earliestAvailableDate;
    private bool _isValidating = false;

    private void Cancel() => Nav.NavigateTo("/bookings");

    protected override async Task OnInitializedAsync()
    {
        Service.StateChanged += StateHasChanged;
        await Service.InitializeAsync(Id, Nav.Uri);
    }

    private void OnDateChanged()
    {
        if (Service.Booking.DepartureDate <= Service.Booking.ArrivalDate)
        {
            Service.Booking.DepartureDate = Service.Booking.ArrivalDate.AddDays(1);
        }
        StateHasChanged();
    }

    private void OnUnitChanged()
    {
        if (Service.Booking.DepartureDate <= Service.Booking.ArrivalDate)
        {
            Service.Booking.DepartureDate = Service.Booking.ArrivalDate.AddDays(1);
        }
        StateHasChanged();
    }

    private async Task HandleSubmit()
    {
        Service.SyncGuestFromSearch();
        _validationErrors.Clear();
        _earliestAvailableDate = null;
        _isValidating = true;
        StateHasChanged();

        try
        {
            var validationResult = await Service.ValidateAsync(Service.Booking);

            if (validationResult?.IsValid == true)
            {
                if (await Service.SubmitAsync(Id))
                    Nav.NavigateTo("/calendar");
            }
            else if (validationResult != null)
            {
                _validationErrors = validationResult.Errors ?? new();
                _earliestAvailableDate = validationResult.EarliestAvailableDate;
            }
            else
            {
                _validationErrors = new() { "Ошибка при проверке данных" };
            }
        }
        finally
        {
            _isValidating = false;
            StateHasChanged();
        }
    }

    public void Dispose()
    {
        Service.StateChanged -= StateHasChanged;
        Service.Dispose();
    }
}