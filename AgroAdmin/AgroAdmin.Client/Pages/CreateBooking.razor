@page "/bookings/create"
@page "/bookings/edit/{Id:int}"
@implements IDisposable
@using AgroAdmin.Client.Components.Bookings
@inject BookingFormService Service
@inject NavigationManager Nav

<div class="container-fluid p-3">
    <div class="card shadow">
        <div class="card-header bg-primary text-white py-2">
            <h5 class="mb-0">@(Id.HasValue ? "✏️ Редактирование" : "✨ Новое бронирование")</h5>
        </div>

        <div class="card-body p-3">
            <EditForm Model="@Service.Booking" OnValidSubmit="HandleSubmit">

                <!-- 1️-3️ Поиск и карточка гостя -->
                <GuestSearchSection Service="Service" />

                <!-- 4️ Даты и объект -->
                <BookingDatesSection Service="Service"
                                     OnDateChanged="OnDateChanged"
                                     OnUnitChanged="OnUnitChanged" />

                <!-- 5️ Календарь занятости -->
                @if (Service.Booking.ArrivalDate != default)
                {
                    <AvailabilityCalendarSection Service="Service" OnDateTap="OnDateTap" />
                }

                <!-- 6️ Состав гостей -->
                <GuestCompositionSection Service="Service" />

                <!-- 7️ Опции -->
                <BookingOptionsSection Service="Service" />

                <!-- 8️ Заметки -->
                <BookingNotesSection Service="Service" />

                <!-- 9️ Валидация -->
                <BookingValidation Errors="validationErrors"
                                   EarliestAvailableDate="earliestAvailableDate"
                                   IsValidating="isValidating" />

                <!-- 10️ Кнопки -->
                <BookingFormActions Id="Id"
                                    OnCancel="Cancel"
                                    IsValidating="isValidating" />

            </EditForm>
        </div>
    </div>
</div>

@code {
    [Parameter] public int? Id { get; set; }

    private List<string> validationErrors = new();
    private DateTime? earliestAvailableDate;
    private bool isValidating = false;

    private void Cancel() => Nav.NavigateTo("/bookings");

    protected override async Task OnInitializedAsync()
    {
        Service.StateChanged += StateHasChanged;
        await Service.InitializeAsync(Id, Nav.Uri);
    }

    private void OnDateChanged()
    {
        if (Service.Booking.DepartureDate <= Service.Booking.ArrivalDate)
        {
            Service.Booking.DepartureDate = Service.Booking.ArrivalDate.AddDays(1);
        }
        StateHasChanged();
    }

    private void OnUnitChanged()
    {
        if (Service.Booking.DepartureDate <= Service.Booking.ArrivalDate)
        {
            Service.Booking.DepartureDate = Service.Booking.ArrivalDate.AddDays(1);
        }
        StateHasChanged();
    }

    private void OnDateTap((DateTime date, string status) data)
    {
        var (date, status) = data;

        if (status == "full-busy" || date < Service.Booking.ArrivalDate || date.Date == Service.Booking.ArrivalDate.Date)
            return;

        var isPeriodFree = true;
        var checkDate = Service.Booking.ArrivalDate;

        while (checkDate <= date)
        {
            var dayStatus = Service.GetDateStatus(checkDate);
            if (dayStatus == "full-busy" ||
                (dayStatus == "partial-busy" && Service.Booking.ReservedUnit != ReservedUnits.WholeHouse))
            {
                isPeriodFree = false;
                break;
            }
            checkDate = checkDate.AddDays(1);
        }

        if (!isPeriodFree)
        {
            var lastFreeDate = Service.Booking.ArrivalDate;
            checkDate = Service.Booking.ArrivalDate.AddDays(1);

            while (checkDate <= date)
            {
                var dayStatus = Service.GetDateStatus(checkDate);
                if (dayStatus == "full-busy" ||
                    (dayStatus == "partial-busy" && Service.Booking.ReservedUnit != ReservedUnits.WholeHouse))
                {
                    break;
                }
                lastFreeDate = checkDate;
                checkDate = checkDate.AddDays(1);
            }

            Service.Booking.DepartureDate = lastFreeDate.AddDays(1);
            StateHasChanged();
            return;
        }

        Service.Booking.DepartureDate = date.AddDays(1);
        StateHasChanged();
    }

    private async Task HandleSubmit()
    {
        validationErrors.Clear();
        earliestAvailableDate = null;
        isValidating = true;
        StateHasChanged();

        try
        {
            var validationResult = await Service.ValidateAsync(Service.Booking);

            if (validationResult?.IsValid == true)
            {
                if (await Service.SubmitAsync(Id))
                    Nav.NavigateTo("/calendar");
            }
            else if (validationResult != null)
            {
                validationErrors = validationResult.Errors ?? new();
                earliestAvailableDate = validationResult.EarliestAvailableDate;
            }
            else
            {
                validationErrors = new() { "Ошибка при проверке данных" };
            }
        }
        finally
        {
            isValidating = false;
            StateHasChanged();
        }
    }

    public void Dispose()
    {
        Service.StateChanged -= StateHasChanged;
        Service.Dispose();
    }
}