@page "/guests"
@using AgroAdmin.Client.Components.Auth
@using AgroAdmin.Shared.Dto
@inject HttpClient Http
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>Гости</PageTitle>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>👥 Гости</h1>
        <button class="btn btn-primary" @onclick='() => Nav.NavigateTo("/guests/create")'>
            Новый гость
        </button>
    </div>

    <div class="row mb-4">
        <div class="col-md-6">
            <div class="input-group">
                <span class="input-group-text">🔍</span>
                <input type="text" class="form-control" placeholder="Поиск по имени или телефону..." 
                       @oninput="OnSearchInput" value="@searchTerm" />
            </div>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="text-center p-5">
            <div class="spinner-border text-primary" role="status"></div>
        </div>
    }
    else if (guests == null || !guests.Any())
    {
        <div class="alert alert-info text-center p-5">
            <i class="bi bi-people fs-1 d-block mb-3"></i>
            @(string.IsNullOrWhiteSpace(searchTerm) 
                ? "Пока нет ни одного гостя" 
                : "Ничего не найдено")
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead class="table-light">
                <tr>
                    <th>Имя</th>
                    <th>Телефон</th>
                    <th>Дата регистрации</th>
                    <th>Бронирований</th>
                    <th>Последний заезд</th>
                    <th>Комментарий</th>
                    <th></th>
                </tr>
                </thead>
                <tbody>
                @foreach (var guest in guests)
                {
                    <tr>
                        <td>
                            <strong>@guest.FullName</strong>
                        </td>
                        <td>@guest.Phone</td>
                        <td>@guest.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy")</td>
                        <td>
                            <span class="badge bg-info rounded-pill">@guest.TotalStays</span>
                        </td>
                        <td>
                            @if (guest.LastBookingDate.HasValue)
                            {
                                @guest.LastBookingDate.Value.ToLocalTime().ToString("dd.MM.yyyy")
                            }
                            else
                            {
                                <span class="text-muted">нет</span>
                            }
                        </td>
                        <td>
                            @if (!string.IsNullOrEmpty(guest.Comment))
                            {
                                <span class="badge bg-warning text-dark" title="@guest.Comment">
                                    Заметка
                                </span>
                            }
                        </td>
                        <td class="text-end">
                            <div class="btn-group">
                                <button class="btn btn-outline-primary btn-sm" 
                                        @onclick='() => Nav.NavigateTo($"/guests/edit/{guest.Id}")'
                                        title="Редактировать">
                                    ✏️
                                </button>
                                <button class="btn btn-outline-info btn-sm" 
                                        @onclick='() => Nav.NavigateTo($"/guests/{guest.Id}/history")'
                                        title="История">
                                    📋
                                </button>
                            </div>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    private List<GuestDto>? guests;
    private string searchTerm = string.Empty;
    private bool isLoading;
    private Timer? debounceTimer;

    protected override async Task OnInitializedAsync()
    {
        await LoadGuests();
    }

    private void OnSearchInput(ChangeEventArgs e)
    {
        searchTerm = e.Value?.ToString() ?? string.Empty;

        // Debounce - ждем 500мс после последнего ввода
        debounceTimer?.Dispose();
        debounceTimer = new Timer(_ =>
        {
            InvokeAsync(async () =>
            {
                await LoadGuests();
                StateHasChanged();
            });
        }, null, 500, Timeout.Infinite);
    }

    private async Task LoadGuests()
    {
        isLoading = true;
        try
        {
            // Если searchTerm пустой - грузим всех через другой endpoint
            var url = string.IsNullOrWhiteSpace(searchTerm) 
                ? "api/guests"  // Нужен будет endpoint для всех гостей
                : $"api/guests/search?term={Uri.EscapeDataString(searchTerm)}";
        
            guests = await Http.GetFromJsonAsync<List<GuestDto>>(url);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Ошибка загрузки: {ex.Message}");
            guests = new();
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    public void Dispose()
    {
        debounceTimer?.Dispose();
    }
}