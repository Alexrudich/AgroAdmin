@page "/bookings"
@using AgroAdmin.Shared.Dto
@using AgroAdmin.Shared.Extensions
@inject HttpClient Http
@inject NavigationManager Nav

<PageTitle>Бронирования</PageTitle>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Учёт заездов</h1>
        @* 2. Привязываем переход по адресу формы *@
        <button class="btn btn-primary" @onclick='() => Nav.NavigateTo("/bookings/create")'>
            Новая бронь
        </button>
    </div>

    @if (allBookings == null)
    {
        <div class="spinner-border" role="status"></div>
    }
    else if (!allBookings.Any())
    {
        <div class="alert alert-info">Пока нет ни одного бронирования.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>Гость</th>
                        <th>Даты</th>
                        <th>Объект</th>
                        <th>Люди</th>
                        <th>Статус</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var booking in allBookings)
                {
                    <tr>
                        <td>
                            <strong>@booking.GuestName</strong>
                            <br />
                            <small class="text-muted">@booking.GuestPhone</small>
                        </td>
                        <td>
                            @booking.ArrivalDate.ToShortDateString() — @booking.DepartureDate.ToShortDateString()
                        </td>
                        <td>
                            <span class="badge bg-secondary">@booking.ReservedUnit.ToFriendlyString()</span>
                        </td>
                        <td>
                            <div class="d-flex flex-column">
                                @* Общее количество крупно *@
                                <span class="fw-bold" style="font-size: 1.1rem;">
                                    Всего гостей: @booking.TotalGuestsCount
                                </span>
        
                                @* Детализация иконками *@
                                <div class="d-flex gap-2" style="font-size: 0.9rem;">
                                    <span title="Взрослые">👨 @booking.AdultsCount</span>
            
                                    @if (booking.ChildrenCount > 0)
                                    {
                                        <span title="Дети (6-17 лет)">👦 @booking.ChildrenCount</span>
                                    }
            
                                    @if (booking.InfantsCount > 0)
                                    {
                                        <span title="Младенцы (до 3 лет)">👶 @booking.InfantsCount</span>
                                    }

                                    @if (booking.HasDog)
                                    {
                                        <span title="С собакой" class="ms-1">🐕</span>
                                    }
                                </div>
                            </div>
                        </td>

                        <td>
                            @if (booking.IsFirstTimeGuest)
                            {
                                <span class="badge bg-warning text-dark">Новый</span>
                            }
                            else
                            {
                                <span class="badge bg-success">Постоянный</span>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    private List<BookingDto>? allBookings;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // Стучимся в наш контроллер из AgroAdmin.API
            allBookings = await Http.GetFromJsonAsync<List<BookingDto>>("api/bookings");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Ошибка загрузки: {ex.Message}");
            allBookings = new();
        }
    }
}
