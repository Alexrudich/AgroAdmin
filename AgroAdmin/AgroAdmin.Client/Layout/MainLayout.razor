@inherits LayoutComponentBase
@inject NavigationManager Navigation

<div class="page @(IsLoginPage ? "login-page" : "app-page")">
    @if (!IsLoginPage)
    {
        <div class="sidebar">
            <NavMenu />
        </div>
    }

    <main class="@(IsLoginPage ? "login-main" : "app-main")">
        <div class="content-container">
            @Body
        </div>
    </main>
</div>

@code {
    private bool IsLoginPage => Navigation.Uri.Contains("/login", StringComparison.OrdinalIgnoreCase);

    protected override void OnInitialized()
    {
        Navigation.LocationChanged += (s, e) => StateHasChanged();
    }
}