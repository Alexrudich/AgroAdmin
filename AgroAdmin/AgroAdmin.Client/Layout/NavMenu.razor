@inject NavigationManager Navigation
@inject IJSRuntime JS

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">Администрирование</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column h-100">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="bookings">
                <span class="bi bi-calendar-check" aria-hidden="true"></span> Бронирования
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="calendar">
                <span class="bi bi-calendar3" aria-hidden="true"></span> Календарь
            </NavLink>
        </div>
        
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="guests">
                <span class="bi bi-people" aria-hidden="true"></span> Гости
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="notifications">
                <span class="bi bi-bell-fill-nav-menu" aria-hidden="true"></span> Напоминания
            </NavLink>
        </div>

        <div class="nav-item px-3 mt-auto">
            <button class="nav-link" @onclick="HandleLogout">
                <span class="bi bi-box-arrow-right" aria-hidden="true"></span> Выйти
            </button>
        </div>
    </nav>
</div>

@code {
    private async Task HandleLogout()
    {
        await JS.InvokeVoidAsync("localStorage.removeItem", "is_auth");
        Navigation.NavigateTo("/login", forceLoad: true);
    }
}